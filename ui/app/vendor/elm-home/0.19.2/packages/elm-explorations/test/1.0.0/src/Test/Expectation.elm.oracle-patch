diff --git a/ui/app/vendor/elm-home/0.19.2/packages/elm-explorations/test/1.0.0/src/Test/Expectation.elm b/ui/app/vendor/elm-home/0.19.2/packages/elm-explorations/test/1.0.0/src/Test/Expectation.elm
new file mode 100644
index 0000000000000000000000000000000000000000..57311c48b5f2f14b4d65681117133c24e205f34a
--- /dev/null
+++ b/ui/app/vendor/elm-home/0.19.2/packages/elm-explorations/test/1.0.0/src/Test/Expectation.elm
@@ -0,0 +1,27 @@
+module Test.Expectation exposing (Expectation(..), fail, withGiven)
+
+import Test.Runner.Failure exposing (Reason)
+
+
+type Expectation
+    = Pass
+    | Fail { given : Maybe String, description : String, reason : Reason }
+
+
+{-| Create a failure without specifying the given.
+-}
+fail : { description : String, reason : Reason } -> Expectation
+fail { description, reason } =
+    Fail { given = Nothing, description = description, reason = reason }
+
+
+{-| Set the given (fuzz test input) of an expectation.
+-}
+withGiven : String -> Expectation -> Expectation
+withGiven newGiven expectation =
+    case expectation of
+        Fail failure ->
+            Fail { failure | given = Just newGiven }
+
+        Pass ->
+            expectation
